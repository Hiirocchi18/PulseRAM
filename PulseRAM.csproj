<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 (LTS). .NET 8 reaches end of support on 10 Nov 2026. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PulseRAM</RootNamespace>
    <AssemblyName>PulseRAM</AssemblyName>
    <Version>1.4.1</Version>
    <Company>Hiirocchi18</Company>
    <Product>PulseRAM</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>PulseRAM.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <AppxGeneratePrisForPortableLibrariesEnabled>false</AppxGeneratePrisForPortableLibrariesEnabled>
    <AppxGetPackagePropertiesEnabled>false</AppxGetPackagePropertiesEnabled>
    <IncludeProjectPriFile>false</IncludeProjectPriFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <!--
    Smaller download: ship English resources only (PulseRAM's UI is English) and let the trimmer drop the parts of
    the .NET and Windows SDK libraries PulseRAM never calls (installer 45.6 MB → ~23 MB). TrimMode=partial only
    trims assemblies marked trimmable; PulseRAM's own code is kept whole, and the WinUI/WinRT projections are rooted
    below because XAML reaches them through metadata the trimmer can't see (trimming them crashes at startup).
    Settings are read with System.Text.Json reflection, so keep that enabled.
  -->
  <PropertyGroup>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinUI/WinRT projections are used through XAML metadata and COM activation the trimmer can't see. -->
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
    <TrimmerRootAssembly Include="WinRT.Runtime" />
    <TrimmerRootAssembly Include="Microsoft.InteractiveExperiences.Projection" />
    <TrimmerRootAssembly Include="Microsoft.WindowsAppRuntime.Bootstrap.Net" />
    <TrimmerRootAssembly Include="Microsoft.Windows.ApplicationModel.WindowsAppRuntime.Projection" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="portable.txt" />
    <!-- The test project lives inside this folder; keep its sources out of the app. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <Content Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="PulseRAM.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Default settings read on first run (user settings are saved to %LocalAppData%\PulseRAM). -->
    <Content Include="pulseram_defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>
  <!--
    Unpackaged WinUI apps load their merged resource index from resources.pri next to the EXE.
    When PRI generation is enabled (release builds: -p:EnableCoreMrtTooling=true -p:AppxGeneratePriEnabled=true),
    publish does not copy the generated $(TargetName).pri, so copy it as resources.pri.
  -->
  <Target Name="PulseRamCopyResourcesPri" AfterTargets="Publish" Condition="'$(ProjectPriFullPath)' != '' and Exists('$(ProjectPriFullPath)')">
    <Copy SourceFiles="$(ProjectPriFullPath)" DestinationFiles="$(PublishDir)resources.pri" />
    <Message Importance="high" Text="PulseRAM: copied $(ProjectPriFullPath) -> $(PublishDir)resources.pri" />
  </Target>
</Project>
