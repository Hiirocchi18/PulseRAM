// Shared look: palette (dark / light) and the small building blocks every view uses.

export global Theme {
    in-out property <bool> dark: true;

    // surfaces
    out property <color> bg: dark ? #060a12 : #eef2f7;
    out property <color> card: dark ? #0d1424 : #ffffff;
    out property <color> inset: dark ? #080d18 : #f4f7fa;
    out property <color> chip: dark ? #151f35 : #e2e8f0;
    out property <color> chip-hover: dark ? #1c2946 : #d5dde8;
    out property <color> line: dark ? #94a3b828 : #47556930;
    out property <color> track: dark ? #1e293b : #e2e8f0;
    // text
    out property <color> text: dark ? #f8fafc : #0f172a;
    out property <color> muted: dark ? #94a3b8 : #475569;
    out property <color> faint: #64748b;
    // accents (darker shades keep contrast on light backgrounds)
    out property <color> blue: dark ? #38bdf8 : #0284c7;
    out property <color> green: dark ? #10b981 : #059669;
    out property <color> mint: dark ? #34d399 : #059669;
    out property <color> amber: dark ? #f59e0b : #b45309;
    out property <color> gold: dark ? #fbbf24 : #b45309;
    out property <color> red: dark ? #f43f5e : #e11d48;
    out property <color> purple: dark ? #a855f7 : #9333ea;
    out property <color> indigo: dark ? #818cf8 : #6366f1;
    out property <color> ice: dark ? #60a5fa : #2563eb;
    out property <color> teal: dark ? #2dd4bf : #0d9488;
    out property <color> cta: #0284c7;
    out property <color> cta-hover: #0369a1;

    // 0 optimal, 1 elevated, 2 critical
    pure public function pressure(level: int) -> color {
        level == 2 ? red : level == 1 ? amber : green
    }

    // Process badge colours: 0 background, 1 foreground, 2 shielded, 3 frozen, 4 eco, 5 leak, 6 idle bloat
    pure public function badge(kind: int) -> color {
        kind == 1 ? blue : kind == 2 ? green : kind == 3 ? ice : kind == 4 ? teal : kind == 5 ? red : kind == 6 ? amber : muted
    }
}

// One tooltip for the whole window: whatever is hovered asks for it, the window draws it after a short delay.
export global Tips {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> wanted;
    in-out property <bool> shown;

    public function ask(tip: string, at-x: length, at-y: length) {
        if (tip != "") {
            text = tip;
            x = at-x;
            y = at-y;
            wanted = true;
        }
    }
    public function drop() {
        wanted = false;
        shown = false;
    }
}

// Invisible hover area that shows a tooltip below itself.
export component Hint inherits TouchArea {
    in property <string> tip;
    changed has-hover => {
        if (self.has-hover) {
            Tips.ask(tip, self.absolute-position.x, self.absolute-position.y + self.height + 6px);
        } else {
            Tips.drop();
        }
    }
}

export component Card inherits Rectangle {
    in property <length> pad: 16px;
    background: Theme.card;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 14px;
    VerticalLayout {
        padding: root.pad;
        @children
    }
}

export component Inset inherits Rectangle {
    background: Theme.inset;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 10px;
}

export component Label inherits Text {
    color: Theme.text;
    font-size: 12px;
    vertical-alignment: center;
}

// Section heading: "MEMORY", "AUTO-PILOT" …
export component Heading inherits Text {
    color: Theme.blue;
    font-size: 12px;
    font-weight: 700;
    vertical-alignment: center;
}

// Lightning bolt, the app's mark.
export component Bolt inherits Path {
    in property <color> tint: white;
    width: 12px;
    height: 16px;
    viewbox-x: 14;
    viewbox-y: 11;
    viewbox-width: 10;
    viewbox-height: 16;
    fill: tint;
    stroke-width: 0px;
    commands: "M 20.5 11 L 14.5 19.5 L 18.8 19.5 L 17.2 27 L 23.5 18.2 L 19.2 18.2 Z";
}

// General-purpose button. `kind`: 0 neutral chip, 1 accent-tinted (active), 2 solid call-to-action.
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <int> kind: 0;
    in property <color> accent: Theme.blue;
    in property <bool> enabled: true;
    in property <length> font-size: 12px;
    in property <int> font-weight: 600;
    in property <length> pad-x: 12px;
    in property <length> pad-y: 6px;
    in property <length> radius: 8px;
    in property <bool> bolt: false;
    callback clicked();

    border-radius: radius;
    border-width: 1px;
    border-color: kind == 1 ? accent.with-alpha(0.55) : kind == 2 ? Theme.blue : Theme.line;
    background: kind == 2 ? (touch.has-hover && enabled ? Theme.cta-hover : Theme.cta)
        : kind == 1 ? accent.with-alpha(touch.has-hover ? 0.28 : 0.18)
        : (touch.has-hover && enabled ? Theme.chip-hover : Theme.chip);
    opacity: enabled ? 1 : 0.55;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: 6px;
        alignment: center;
        if root.bolt: VerticalLayout {
            alignment: center;
            Bolt {
                tint: root.kind == 2 ? white : Theme.amber;
            }
        }
        Text {
            text: root.text;
            color: root.kind == 2 ? white : root.kind == 1 ? root.accent : Theme.text;
            font-size: root.font-size;
            font-weight: root.font-weight;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            Tips.drop();
            root.clicked();
        }
        changed has-hover => {
            if (self.has-hover) {
                Tips.ask(root.tip, root.absolute-position.x, root.absolute-position.y + root.height + 6px);
            } else {
                Tips.drop();
            }
        }
    }
}

// Rounded status chip ("OPTIMAL LOAD", "SHIELDED" …).
export component Pill inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.green;
    in property <length> font-size: 9.5px;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: tint.with-alpha(0.45);
    background: tint.with-alpha(0.14);
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: root.font-size;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// On/off switch.
export component Toggle inherits Rectangle {
    in-out property <bool> on;
    in property <string> label;
    in property <string> tip;
    callback toggled(bool);

    horizontal-stretch: 0;
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 38px;
                height: 20px;
                border-radius: 10px;
                border-width: 1px;
                border-color: root.on ? Theme.cta : Theme.muted;
                background: root.on ? Theme.cta : transparent;
                Rectangle {
                    width: 12px;
                    height: 12px;
                    border-radius: 6px;
                    y: 4px;
                    x: root.on ? 22px : 4px;
                    background: root.on ? white : Theme.muted;
                    animate x {
                        duration: 120ms;
                        easing: ease-out;
                    }
                }
            }
        }
        if root.label != "": Label {
            text: root.label;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
        changed has-hover => {
            if (self.has-hover) {
                Tips.ask(root.tip, root.absolute-position.x, root.absolute-position.y + root.height + 6px);
            } else {
                Tips.drop();
            }
        }
    }
}

export component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> tip;
    callback toggled(bool);

    horizontal-stretch: 0;
    HorizontalLayout {
        spacing: 7px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.checked ? Theme.cta : Theme.muted;
                background: root.checked ? Theme.cta : transparent;
                if root.checked: Path {
                    width: 10px;
                    height: 8px;
                    viewbox-width: 10;
                    viewbox-height: 8;
                    stroke: white;
                    stroke-width: 1.8px;
                    commands: "M 1 4 L 4 7 L 9 1";
                }
            }
        }
        Label {
            text: root.text;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
        changed has-hover => {
            if (self.has-hover) {
                Tips.ask(root.tip, root.absolute-position.x, root.absolute-position.y + root.height + 6px);
            } else {
                Tips.drop();
            }
        }
    }
}

// Horizontal slider with a filled track.
export component Slide inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in-out property <float> value;
    callback changed(float);
    callback released(float);

    height: 22px;
    property <float> ratio: clamp((value - minimum) / max(0.0001, maximum - minimum), 0, 1);

    function set-from(position: length) {
        root.value = clamp(minimum + round(clamp(position / self.width, 0, 1) * (maximum - minimum) / step) * step, minimum, maximum);
        root.changed(root.value);
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.track;
        Rectangle {
            x: 0;
            width: parent.width * root.ratio;
            border-radius: 2px;
            background: Theme.cta;
        }
    }

    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        x: (parent.width - self.width) * root.ratio;
        y: (parent.height - self.height) / 2;
        background: white;
        border-width: 4px;
        border-color: Theme.cta;
    }

    TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.set-from(self.mouse-x);
            } else if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                root.released(root.value);
            }
        }
        moved => {
            if (self.pressed) {
                root.set-from(self.mouse-x);
            }
        }
    }
}

// Segmented choice ("Smart | Deep | Standby | Max"): compact, and needs no popup window.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    in property <string> tip;
    callback picked(int);

    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.inset;
    horizontal-stretch: 0;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for option[i] in root.options: Rectangle {
            border-radius: 6px;
            background: i == root.index ? Theme.blue.with-alpha(0.2) : cell.has-hover ? Theme.chip : transparent;
            border-width: 1px;
            border-color: i == root.index ? Theme.blue.with-alpha(0.5) : transparent;
            HorizontalLayout {
                padding-left: 9px;
                padding-right: 9px;
                padding-top: 4px;
                padding-bottom: 4px;
                Text {
                    text: option;
                    color: i == root.index ? Theme.text : Theme.muted;
                    font-size: 11.5px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            cell := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.index = i;
                    root.picked(i);
                }
                changed has-hover => {
                    if (self.has-hover) {
                        Tips.ask(root.tip, root.absolute-position.x, root.absolute-position.y + root.height + 6px);
                    } else {
                        Tips.drop();
                    }
                }
            }
        }
    }
}

// The floating tooltip itself; place one at the end of a window.
export component TipLayer inherits Rectangle {
    in property <length> window-width;
    in property <length> window-height;

    timer := Timer {
        interval: 550ms;
        running: Tips.wanted && !Tips.shown;
        triggered => {
            Tips.shown = true;
        }
    }

    if Tips.shown && Tips.wanted: Rectangle {
        property <length> box-width: min(340px, root.window-width - 16px);
        x: clamp(Tips.x, 8px, max(8px, root.window-width - self.width - 8px));
        y: Tips.y + self.height + 8px > root.window-height ? max(4px, Tips.y - self.height - 40px) : Tips.y;
        width: box-width;
        height: tip-text.preferred-height + 14px;
        border-radius: 7px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.dark ? #1e293b : #ffffff;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000055;
        tip-text := Text {
            x: 9px;
            y: 7px;
            width: parent.width - 18px;
            text: Tips.text;
            color: Theme.text;
            font-size: 11.5px;
            wrap: word-wrap;
        }
    }
}
