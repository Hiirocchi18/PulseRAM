// PulseRAM's interface: the dashboard window and the compact always-on-top widget.
// Rust fills the `App` global with ready-to-show text and numbers; everything the user does comes back
// through its callbacks.

import { Theme, Tips, Hint, Card, Inset, Label, Heading, Bolt, Btn, Pill, Toggle, Check, Slide, Segmented, TipLayer } from "widgets.slint";

export { Theme }

export struct ProcRow {
    name: string,
    initials: string,
    meta: string,
    badge: string,
    badge-kind: int,
    memory: string,
    score: string,
    eco: bool,
    frozen: bool,
    shielded: bool,
    cap: string,
}

export struct EventRow {
    title: string,
    time: string,
    reason: string,
    detail: string,
}

export struct LeakRow {
    app: string,
    meta: string,
    busy: bool,
}

export struct ProfileRow {
    id: string,
    name: string,
    summary: string,
    description: string,
    active: bool,
}

export global App {
    // ---- live readings ----
    in property <string> clock;
    in property <string> percent-text: "0.0%";
    in property <string> used-text: "0.00 / 0.00 GB";
    in property <int> pressure;
    in property <string> pressure-text: "OPTIMAL LOAD";
    in property <float> used-ratio: 0.01;
    in property <float> combined-ratio: 0.01;
    in property <float> threshold: 80;
    in property <float> bar-used: 50;
    in property <float> bar-cache: 25;
    in property <float> bar-free: 25;
    in property <string> avail-summary: "-- GB Available";
    in property <string> legend-used: "-- GB";
    in property <string> legend-cache: "-- GB";
    in property <string> legend-avail: "-- GB";
    in property <string> standby-tip;
    in property <string> clean-sub: "--";
    in property <string> last-sweep: "Ready";
    in property <string> trimmed;
    in property <string> trimmed-sub;
    in property <string> commit;
    in property <string> commit-sub;
    in property <int> commit-level;
    in property <string> pagefile;
    in property <string> pagefile-sub;
    in property <string> kernel;
    in property <string> kernel-sub;
    in property <string> cpu;
    in property <string> cpu-sub;
    in property <string> rules;
    in property <string> rules-sub;
    in property <string> chart-ram;
    in property <string> chart-area;
    in property <string> chart-cpu;
    in-out property <length> chart-width;
    in-out property <length> chart-height;
    in property <[ProcRow]> top-apps;
    in property <[ProcRow]> processes;
    in property <string> process-count: "0";
    in property <[EventRow]> events;
    in property <string> event-count: "0 sweeps";
    in property <[LeakRow]> leaks;
    in property <[ProfileRow]> profiles;

    // ---- view state ----
    in-out property <int> view;
    in-out property <int> mode;
    in property <bool> cleaning;
    in property <bool> is-admin;
    in property <bool> focus-on;
    in property <string> auto-pill: "Auto 80%";
    in property <string> auto-tip;
    in-out property <string> search;
    in-out property <int> sort;
    in-out property <int> grouping;
    in-out property <int> filter;

    // ---- settings ----
    in-out property <bool> auto-on: true;
    in-out property <float> trigger: 80;
    in-out property <float> min-free: 1;
    in-out property <int> auto-mode;
    in-out property <int> cooldown: 2;
    in-out property <bool> protect-foreground: true;
    in-out property <bool> chime;
    in-out property <bool> leak-guard: true;
    in-out property <bool> scheduled;
    in-out property <int> schedule-interval: 1;
    in property <string> schedule-countdown: "off";
    in-out property <bool> startup;
    in property <string> startup-tip;
    in-out property <bool> profiles-auto: true;
    in-out property <bool> hotkeys-on: true;
    in property <string> hotkeys-tip;
    in property <string> hotkey-smart;
    in property <string> hotkey-deep;
    in property <string> device-label;
    in-out property <bool> tray-percent: true;
    in-out property <bool> eco-in-tray: true;
    in-out property <bool> smart-purge: true;
    in-out property <bool> minimize-to-tray: true;
    in-out property <bool> memory-warnings: true;
    in-out property <bool> updates: true;
    in-out property <int> ui-mode;
    in-out property <int> theme-choice;

    // ---- banners, toast, dialogs ----
    in property <bool> commit-banner;
    in property <bool> commit-critical;
    in property <string> commit-title;
    in property <string> commit-body;
    in property <bool> commit-fix;
    in property <bool> update-banner;
    in property <string> update-title;
    in property <bool> toast;
    in property <string> toast-title;
    in property <string> toast-sub;
    in-out property <bool> cap-open;
    in property <string> cap-app;
    in property <string> cap-intro;
    in-out property <string> cap-value;
    in-out property <bool> welcome-open;
    in property <string> welcome-device;
    in property <string> welcome-auto;
    in-out property <bool> welcome-startup;
    in-out property <bool> welcome-updates;

    // ---- what the user did ----
    // Commands: "clean", "focus", "compact", "admin", "thaw-all", "use-auto-detect", "check-updates", "retune", "logs",
    // "commit-fix", "commit-dismiss", "update-download", "update-skip", "update-later", "cap-apply", "cap-remove",
    // "welcome-start", "welcome-compact", "preset" (arg = name), "profile" (arg = id),
    // "trim" / "eco" / "freeze" / "cap" / "shield" / "leak-restart" / "leak-dismiss" / "leak-ignore" (arg = app).
    callback command(string, string);
    callback set-flag(string, bool);
    callback set-choice(string, int);
    callback set-number(string, float);
    callback refresh();
}

// ---------------------------------------------------------------------------------------------------------

component Logo inherits Rectangle {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: Theme.dark ? #0a1326 : #f8fafc;
    border-width: 1.5px;
    border-color: Theme.blue.with-alpha(0.63);
    // chip pins
    for position in [11, 18, 25]: Rectangle {
        x: position * 1px;
        y: 4px;
        width: 2.2px;
        height: 4px;
        background: Theme.blue;
    }
    for position in [11, 18, 25]: Rectangle {
        x: position * 1px;
        y: 30px;
        width: 2.2px;
        height: 4px;
        background: Theme.blue;
    }
    for position in [11, 18, 25]: Rectangle {
        x: 4px;
        y: position * 1px;
        width: 4px;
        height: 2.2px;
        background: Theme.indigo;
    }
    for position in [11, 18, 25]: Rectangle {
        x: 30px;
        y: position * 1px;
        width: 4px;
        height: 2.2px;
        background: Theme.indigo;
    }
    Rectangle {
        x: 9px;
        y: 9px;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        background: Theme.dark ? #091122 : #f1f5f9;
        border-width: 1.4px;
        border-color: Theme.blue;
    }
    Bolt {
        x: 14px;
        y: 11px;
        width: 10px;
        height: 16px;
        tint: Theme.dark ? #e0f2fe : Theme.blue;
    }
}

// Scrolling area with a slim scroll bar. The single child should be a layout; pass its preferred height.
component Scroll inherits Rectangle {
    in property <length> body-height;
    clip: true;
    flick := Flickable {
        interactive: false;
        content-width: self.width;
        content-height: max(self.height, root.body-height);
        @children
    }
    if flick.content-height > flick.height + 1px: Rectangle {
        property <length> travel: root.height - self.height;
        property <length> scrollable: flick.content-height - flick.height;
        x: root.width - 6px;
        width: 5px;
        height: max(28px, root.height * (flick.height / flick.content-height));
        y: travel * (-flick.content-y / scrollable);
        border-radius: 2.5px;
        background: bar.pressed || bar.has-hover ? Theme.muted : Theme.muted.with-alpha(0.45);
        bar := TouchArea {
            x: -6px;
            width: 17px;
            property <length> grab-offset;
            pointer-event(event) => {
                if (event.kind == PointerEventKind.down) {
                    self.grab-offset = self.mouse-y;
                }
            }
            moved => {
                if (self.pressed) {
                    flick.content-y = -clamp((parent.y + self.mouse-y - self.grab-offset) / max(1px, parent.travel), 0, 1) * parent.scrollable;
                }
            }
        }
    }
}

component Field inherits Inset {
    in property <string> placeholder;
    in-out property <string> text <=> input.text;
    in property <InputType> input-type: InputType.text;
    callback edited(string);
    callback accepted();
    height: 30px;
    border-color: input.has-focus ? Theme.blue : Theme.line;
    Text {
        x: 10px;
        width: parent.width - 20px;
        text: input.text == "" ? root.placeholder : "";
        color: Theme.faint;
        font-size: 12px;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        single-line: true;
        input-type: root.input-type;
        selection-background-color: Theme.blue.with-alpha(0.4);
        edited => {
            root.edited(self.text);
        }
        accepted => {
            root.accepted();
        }
    }
}

component NavTab inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <bool> active;
    callback clicked();
    border-radius: 8px;
    border-width: 1px;
    border-color: active ? Theme.blue.with-alpha(0.47) : transparent;
    background: active ? Theme.blue.with-alpha(0.18) : touch.has-hover ? Theme.chip : transparent;
    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 6px;
        Text {
            text: root.text;
            color: root.active ? Theme.text : Theme.muted;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        if root.count != "": Text {
            text: root.count;
            color: Theme.blue;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component TopBar inherits Rectangle {
    background: Theme.card;
    border-color: Theme.line;
    border-width: 1px;
    border-radius: 14px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 12px;
        Logo { }
        Text {
            text: "PulseRAM";
            color: Theme.text;
            font-size: 17.5px;
            font-weight: 800;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            padding-left: 8px;
            Rectangle {
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.line;
                background: Theme.inset;
                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;
                    NavTab {
                        text: "Overview";
                        active: App.view == 0;
                        clicked => {
                            App.view = 0;
                            App.refresh();
                        }
                    }
                    NavTab {
                        text: "Processes";
                        count: App.process-count;
                        active: App.view == 1;
                        clicked => {
                            App.view = 1;
                            App.refresh();
                        }
                    }
                    NavTab {
                        text: "Profiles";
                        active: App.view == 2;
                        clicked => {
                            App.view = 2;
                            App.refresh();
                        }
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    text: App.focus-on ? "Focus On" : "Focus";
                    bolt: true;
                    kind: App.focus-on ? 1 : 0;
                    accent: Theme.purple;
                    radius: 14px;
                    font-size: 11.5px;
                    pad-y: 5px;
                    tip: "Focus Boost: temporarily lowers the Auto-Pilot trigger to 62% and trims idle apps now.";
                    clicked => {
                        App.command("focus", "");
                    }
                }
                Rectangle {
                    horizontal-stretch: 0;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: Theme.chip;
                    HorizontalLayout {
                        padding-left: 11px;
                        padding-right: 11px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        spacing: 7px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: App.auto-on ? Theme.green : Theme.faint;
                            }
                        }
                        Text {
                            text: App.auto-pill;
                            color: Theme.text;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    Hint {
                        tip: App.auto-tip;
                    }
                }
                compact := Rectangle {
                    width: 36px;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: Theme.line;
                    background: compact-touch.has-hover ? Theme.chip-hover : Theme.chip;
                    // a small window in the corner of a bigger one
                    Path {
                        width: 14px;
                        height: 12px;
                        viewbox-width: 14;
                        viewbox-height: 12;
                        stroke: Theme.text;
                        stroke-width: 1.3px;
                        commands: "M 0.7 0.7 H 13.3 V 11.3 H 0.7 Z M 7 6 H 13.3 M 7 6 V 11.3";
                    }
                    compact-touch := Hint {
                        tip: "Compact, always-on-top view";
                        mouse-cursor: pointer;
                        clicked => {
                            Tips.drop();
                            App.command("compact", "");
                        }
                    }
                }
                Btn {
                    text: App.is-admin ? "✓ Admin" : "Admin";
                    kind: 1;
                    accent: App.is-admin ? Theme.mint : Theme.gold;
                    radius: 14px;
                    font-size: 11.5px;
                    font-weight: 700;
                    pad-y: 5px;
                    tip: App.is-admin ? "Running as administrator: kernel purges available." : "Restart as administrator to enable standby-cache purges and page combining.";
                    clicked => {
                        App.command("admin", "");
                    }
                }
            }
        }
    }
}

component Banner inherits Rectangle {
    in property <color> tint;
    in property <string> title;
    in property <string> body;
    border-radius: 12px;
    border-width: 1px;
    border-color: tint.with-alpha(0.5);
    background: tint.with-alpha(0.12);
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 10px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            alignment: center;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 13px;
                font-weight: 700;
                wrap: word-wrap;
            }
            if root.body != "": Text {
                text: root.body;
                color: Theme.muted;
                font-size: 11.5px;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                @children
            }
        }
    }
}

component Gauge inherits Rectangle {
    width: 220px;
    height: 220px;
    property <float> used: App.used-ratio;
    property <float> combined: App.combined-ratio;
    property <float> marker: App.threshold;
    animate used, combined, marker {
        duration: 420ms;
        easing: ease-out;
    }
    // halo
    Rectangle {
        x: 7px;
        y: 7px;
        width: 206px;
        height: 206px;
        border-radius: 103px;
        border-width: 2px;
        border-color: Theme.pressure(App.pressure).with-alpha(0.22);
        background: Theme.blue.with-alpha(0.03);
    }
    // track
    Rectangle {
        x: 18px;
        y: 18px;
        width: 184px;
        height: 184px;
        border-radius: 92px;
        border-width: 14px;
        border-color: Theme.track;
    }
    // used + standby cache
    Path {
        width: 220px;
        height: 220px;
        viewbox-width: 220;
        viewbox-height: 220;
        stroke: #6366f1.with-alpha(0.5);
        stroke-width: 14px;
        stroke-line-cap: round;
        MoveTo {
            x: 110;
            y: 25;
        }
        ArcTo {
            x: 110 + 85 * sin(clamp(root.combined, 0.005, 0.999) * 360deg);
            y: 110 - 85 * cos(clamp(root.combined, 0.005, 0.999) * 360deg);
            radius-x: 85;
            radius-y: 85;
            sweep: true;
            large-arc: root.combined > 0.5;
        }
    }
    // in use
    Path {
        width: 220px;
        height: 220px;
        viewbox-width: 220;
        viewbox-height: 220;
        stroke: Theme.pressure(App.pressure);
        stroke-width: 14px;
        stroke-line-cap: round;
        MoveTo {
            x: 110;
            y: 25;
        }
        ArcTo {
            x: 110 + 85 * sin(clamp(root.used, 0.005, 0.999) * 360deg);
            y: 110 - 85 * cos(clamp(root.used, 0.005, 0.999) * 360deg);
            radius-x: 85;
            radius-y: 85;
            sweep: true;
            large-arc: root.used > 0.5;
        }
    }
    // Auto-Pilot trigger
    Rectangle {
        width: 12px;
        height: 12px;
        border-radius: 6px;
        x: 110px + 85px * sin(root.marker / 100 * 360deg) - 6px;
        y: 110px - 85px * cos(root.marker / 100 * 360deg) - 6px;
        background: Theme.red;
        border-width: 2px;
        border-color: white;
    }
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: App.percent-text;
            color: Theme.text;
            font-size: 36px;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: App.used-text;
            color: Theme.muted;
            font-size: 12px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            padding-top: 4px;
            Pill {
                text: App.pressure-text;
                tint: Theme.pressure(App.pressure);
                font-size: 10px;
            }
        }
    }
}

component LegendCell inherits Rectangle {
    in property <string> title;
    in property <color> dot;
    in property <string> value;
    in property <string> tip;
    VerticalLayout {
        spacing: 1px;
        HorizontalLayout {
            spacing: 5px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 2px;
                    background: root.dot;
                }
            }
            Text {
                text: root.title;
                color: Theme.muted;
                font-size: 10px;
            }
        }
        Text {
            text: root.value;
            color: Theme.text;
            font-size: 12px;
            font-weight: 700;
            overflow: elide;
        }
    }
    if root.tip != "": Hint {
        tip: root.tip;
    }
}

component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> tag;
    in property <string> tip;
    in property <int> index;
    property <bool> selected: App.mode == index;
    border-radius: 10px;
    border-width: 1px;
    border-color: selected ? Theme.blue : Theme.line;
    background: selected ? Theme.blue.with-alpha(0.16) : touch.has-hover ? Theme.chip-hover : Theme.chip.with-alpha(0.6);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 8px;
        padding-bottom: 8px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.tag;
            color: Theme.blue;
            font-size: 9.5px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
    touch := Hint {
        tip: root.tip;
        mouse-cursor: pointer;
        clicked => {
            App.mode = root.index;
            App.set-choice("mode", root.index);
        }
    }
}

component ReactorCard inherits Card {
    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            Heading {
                text: "MEMORY";
                horizontal-stretch: 1;
            }
            Text {
                text: App.clock;
                color: Theme.muted;
                font-size: 11.5px;
                vertical-alignment: center;
            }
        }
        HorizontalLayout {
            alignment: center;
            Gauge { }
        }
        Inset {
            VerticalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 7px;
                HorizontalLayout {
                    Text {
                        text: "RAM";
                        color: Theme.muted;
                        font-size: 11px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: App.avail-summary;
                        color: Theme.text;
                        font-size: 11.5px;
                        font-weight: 700;
                    }
                }
                HorizontalLayout {
                    height: 9px;
                    spacing: 2px;
                    Rectangle {
                        horizontal-stretch: App.bar-used;
                        min-width: 4px;
                        border-top-left-radius: 4px;
                        border-bottom-left-radius: 4px;
                        background: Theme.blue;
                    }
                    Rectangle {
                        horizontal-stretch: App.bar-cache;
                        min-width: 4px;
                        background: Theme.indigo;
                    }
                    Rectangle {
                        horizontal-stretch: App.bar-free;
                        min-width: 4px;
                        border-top-right-radius: 4px;
                        border-bottom-right-radius: 4px;
                        background: Theme.green.with-alpha(0.45);
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    LegendCell {
                        title: "In Use";
                        dot: Theme.blue;
                        value: App.legend-used;
                    }
                    LegendCell {
                        title: "Standby";
                        dot: Theme.indigo;
                        value: App.legend-cache;
                        tip: App.standby-tip;
                    }
                    LegendCell {
                        title: "Available";
                        dot: Theme.green;
                        value: App.legend-avail;
                    }
                }
            }
        }
        Text {
            text: "MODE";
            color: Theme.muted;
            font-size: 10.5px;
            font-weight: 700;
        }
        GridLayout {
            spacing: 6px;
            Row {
                ModeCard {
                    index: 0;
                    title: "Smart";
                    tag: "SAFE";
                    tip: "Trims idle background apps only. Never touches the active window or shielded apps.";
                }
                ModeCard {
                    index: 1;
                    title: "Deep";
                    tip: "Trims every unshielded app. As administrator, also purges the low-priority standby cache and combines identical pages.";
                }
            }
            Row {
                ModeCard {
                    index: 2;
                    title: "Standby";
                    tag: "ADMIN";
                    tip: "Empties the Windows standby cache and flushes modified pages. Requires administrator.";
                }
                ModeCard {
                    index: 3;
                    title: "Max";
                    tag: "ADMIN";
                    tip: "Deep trim + page combining + full standby purge. The kernel part requires administrator.";
                }
            }
        }
        clean := Rectangle {
            height: 50px;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.blue;
            background: clean-touch.has-hover && !App.cleaning ? Theme.cta-hover : Theme.cta;
            opacity: App.cleaning ? 0.6 : 1;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    if !App.cleaning: VerticalLayout {
                        alignment: center;
                        Bolt {
                            tint: #fde68a;
                        }
                    }
                    Text {
                        text: App.cleaning ? "Cleaning…" : App.mode == 1 ? "Clean · Deep" : App.mode == 2 ? "Clean · Standby" : App.mode == 3 ? "Clean · Max" : "Clean · Smart";
                        color: white;
                        font-size: 14.5px;
                        font-weight: 800;
                    }
                }
                Text {
                    text: App.clean-sub;
                    color: #e0f2fe;
                    font-size: 11px;
                    horizontal-alignment: center;
                }
            }
            clean-touch := TouchArea {
                enabled: !App.cleaning;
                mouse-cursor: pointer;
                clicked => {
                    App.command("clean", "");
                }
            }
        }
        Inset {
            border-radius: 9px;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                padding-top: 7px;
                padding-bottom: 7px;
                Text {
                    text: App.last-sweep;
                    color: Theme.muted;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }
}

component Vital inherits Inset {
    in property <string> label;
    in property <string> value;
    in property <string> sub;
    in property <color> tint: Theme.text;
    VerticalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 2px;
        Text {
            text: root.label;
            color: Theme.faint;
            font-size: 10px;
            font-weight: 700;
        }
        Text {
            text: root.value;
            color: root.tint;
            font-size: 15.5px;
            font-weight: 800;
            overflow: elide;
        }
        Text {
            text: root.sub;
            color: Theme.muted;
            font-size: 10.5px;
            overflow: elide;
        }
    }
}

component TelemetryCard inherits Card {
    VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            Heading {
                text: "LAST 60 S";
                horizontal-stretch: 1;
            }
            Text {
                text: "RAM · CPU · trigger";
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        Inset {
            height: 140px;
            border-radius: 11px;
            chart := Rectangle {
                x: 6px;
                y: 6px;
                width: parent.width - 12px;
                height: parent.height - 12px;
                clip: true;
                init => {
                    App.chart-width = self.width;
                    App.chart-height = self.height;
                }
                changed width => {
                    App.chart-width = self.width;
                    App.refresh();
                }
                for percent in [25, 50, 75]: Rectangle {
                    y: parent.height * (100 - percent) / 100;
                    height: 1px;
                    background: Theme.muted.with-alpha(0.09);
                }
                // dashed trigger line
                for dash in 240: Rectangle {
                    x: dash * 8px;
                    y: parent.height * (100 - clamp(App.threshold, 10, 98)) / 100;
                    width: 4px;
                    height: 1.5px;
                    background: Theme.red.with-alpha(0.6);
                }
                if App.chart-ram != "": Path {
                    viewbox-width: chart.width / 1px;
                    viewbox-height: chart.height / 1px;
                    fill: Theme.blue.with-alpha(0.16);
                    stroke-width: 0px;
                    commands: App.chart-area;
                }
                if App.chart-ram != "": Path {
                    viewbox-width: chart.width / 1px;
                    viewbox-height: chart.height / 1px;
                    stroke: Theme.green.with-alpha(0.5);
                    stroke-width: 1.5px;
                    commands: App.chart-cpu;
                }
                if App.chart-ram != "": Path {
                    viewbox-width: chart.width / 1px;
                    viewbox-height: chart.height / 1px;
                    stroke: Theme.blue;
                    stroke-width: 2.4px;
                    commands: App.chart-ram;
                }
            }
        }
        GridLayout {
            spacing: 8px;
            Row {
                Vital {
                    label: "TRIMMED";
                    value: App.trimmed;
                    sub: App.trimmed-sub;
                    tint: Theme.mint;
                }
                Vital {
                    label: "COMMIT";
                    value: App.commit;
                    sub: App.commit-sub;
                    tint: App.commit-level == 2 ? Theme.red : App.commit-level == 1 ? Theme.amber : Theme.text;
                }
                Vital {
                    label: "PAGEFILE";
                    value: App.pagefile;
                    sub: App.pagefile-sub;
                }
            }
            Row {
                Vital {
                    label: "KERNEL";
                    value: App.kernel;
                    sub: App.kernel-sub;
                }
                Vital {
                    label: "CPU";
                    value: App.cpu;
                    sub: App.cpu-sub;
                    tint: Theme.blue;
                }
                Vital {
                    label: "RULES";
                    value: App.rules;
                    sub: App.rules-sub;
                    tint: Theme.purple;
                }
            }
        }
    }
}

component SliderBox inherits Inset {
    in property <string> title;
    in property <string> value-text;
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 8px;
        spacing: 6px;
        HorizontalLayout {
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 11.5px;
                font-weight: 600;
                horizontal-stretch: 1;
            }
            Text {
                text: root.value-text;
                color: Theme.blue;
                font-size: 12.5px;
                font-weight: 700;
            }
        }
        @children
    }
}

component GuardTile inherits Inset {
    in property <string> title;
    in property <string> sub;
    in property <string> tip;
    in-out property <bool> on;
    callback toggled(bool);
    Hint {
        tip: root.tip;
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: 11.5px;
                font-weight: 700;
                overflow: elide;
            }
            if root.sub != "": Text {
                text: root.sub;
                color: Theme.muted;
                font-size: 10.5px;
                overflow: elide;
            }
        }
        @children
        Toggle {
            on <=> root.on;
            toggled(value) => {
                root.toggled(value);
            }
        }
    }
}

component AutoPilotCard inherits Card {
    VerticalLayout {
        spacing: 10px;
        HorizontalLayout {
            Heading {
                text: "AUTO-PILOT";
                horizontal-stretch: 1;
            }
            Toggle {
                on <=> App.auto-on;
                label: App.auto-on ? "On" : "Off";
                tip: "Automatically trims idle apps when RAM crosses the trigger or free RAM drops below the floor.";
                toggled(value) => {
                    App.set-flag("auto", value);
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            SliderBox {
                title: "Trigger at";
                value-text: round(App.trigger) + "%";
                Slide {
                    minimum: 50;
                    maximum: 95;
                    step: 1;
                    value <=> App.trigger;
                    released(value) => {
                        App.set-number("trigger", value);
                    }
                }
            }
            SliderBox {
                title: "Min free";
                value-text: (round(App.min-free * 10) / 10) + (mod(round(App.min-free * 10), 10) == 0 ? ".0 GB" : " GB");
                Slide {
                    minimum: 0.5;
                    maximum: 8;
                    step: 0.5;
                    value <=> App.min-free;
                    released(value) => {
                        App.set-number("min-free", value);
                    }
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            for preset in ["Gaming", "Balanced", "Heavy"]: Btn {
                text: preset;
                font-size: 11.5px;
                tip: preset == "Gaming" ? "Trigger 70% · floor 3.0 GB · smart" : preset == "Balanced" ? "Trigger 80% · floor 2.0 GB · smart" : "Trigger 88% · floor 1.5 GB · deep";
                clicked => {
                    App.command("preset", preset);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            Segmented {
                options: ["Smart", "Deep", "Standby", "Max"];
                index <=> App.auto-mode;
                tip: "What an automatic sweep does.";
                picked(index) => {
                    App.set-choice("auto-mode", index);
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Label {
                text: "At most every";
                color: Theme.muted;
                font-size: 11.5px;
            }
            Segmented {
                options: ["30s", "1 min", "2 min", "5 min", "10 min"];
                index <=> App.cooldown;
                tip: "Minimum gap between Auto-Pilot sweeps. Doubles automatically (up to 30 min) while sweeps can't relieve memory pressure.";
                picked(index) => {
                    App.set-choice("cooldown", index);
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
        }
        GridLayout {
            spacing: 8px;
            Row {
                GuardTile {
                    title: "Protect active app";
                    tip: "Never trims the window you are using.";
                    on <=> App.protect-foreground;
                    toggled(value) => {
                        App.set-flag("protect-foreground", value);
                    }
                    Check {
                        text: "Chime";
                        tip: "Play a sound after an automatic sweep.";
                        checked <=> App.chime;
                        toggled(value) => {
                            App.set-flag("chime", value);
                        }
                    }
                }
                GuardTile {
                    title: "Leak guard";
                    tip: "Flags apps whose private memory keeps growing (+120 MB/min) and trims them at most every 5 min.";
                    on <=> App.leak-guard;
                    toggled(value) => {
                        App.set-flag("leak-guard", value);
                    }
                }
            }
            Row {
                GuardTile {
                    title: "Every";
                    sub: App.schedule-countdown;
                    tip: "Runs a maintenance sweep on a fixed schedule.";
                    on <=> App.scheduled;
                    toggled(value) => {
                        App.set-flag("scheduled", value);
                    }
                    VerticalLayout {
                        alignment: center;
                        Segmented {
                            options: ["10m", "15m", "30m", "60m"];
                            index <=> App.schedule-interval;
                            picked(index) => {
                                App.set-choice("schedule-interval", index);
                            }
                        }
                    }
                }
                GuardTile {
                    title: "Start with Windows";
                    tip: App.startup-tip;
                    on <=> App.startup;
                    toggled(value) => {
                        App.set-flag("startup", value);
                    }
                }
            }
        }
    }
}

component ActionBtn inherits Btn {
    in property <bool> active;
    kind: active ? 1 : 0;
    font-size: 10.5px;
    pad-x: 8px;
    pad-y: 4px;
    radius: 6px;
}

component ProcessRow inherits Inset {
    in property <ProcRow> item;
    // Narrow rows (the dashboard's Top Apps list in a small window) keep only the Trim button.
    in property <bool> compact;
    height: 44px;
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 7px;
                border-width: 1px;
                border-color: Theme.blue.with-alpha(0.35);
                background: Theme.blue.with-alpha(0.14);
                Text {
                    text: root.item.initials;
                    color: Theme.blue;
                    font-size: 10.5px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 90px;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.item.name;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.item.meta;
                color: Theme.muted;
                font-size: 10.5px;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            width: 100px;
            HorizontalLayout {
                alignment: start;
                Pill {
                    text: root.item.badge;
                    tint: Theme.badge(root.item.badge-kind);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            width: 96px;
            spacing: 2px;
            Text {
                text: root.item.memory;
                color: Theme.text;
                font-size: 12.5px;
                font-weight: 700;
            }
            Text {
                text: root.item.score;
                color: Theme.faint;
                font-size: 10px;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 4px;
                ActionBtn {
                    text: "Trim";
                    tip: "Page this app's memory out now.";
                    clicked => {
                        App.command("trim", root.item.name);
                    }
                }
                if !root.compact: ActionBtn {
                    text: "Eco";
                    active: root.item.eco;
                    accent: Theme.teal;
                    tip: "Efficiency Mode: lowest priority and EcoQoS for this app.";
                    clicked => {
                        App.command("eco", root.item.name);
                    }
                }
                if !root.compact: ActionBtn {
                    text: root.item.frozen ? "Thaw" : "Freeze";
                    min-width: 52px;
                    active: root.item.frozen;
                    accent: Theme.ice;
                    tip: "Suspends the app completely until you thaw it.";
                    clicked => {
                        App.command("freeze", root.item.name);
                    }
                }
                if !root.compact: ActionBtn {
                    text: root.item.cap != "" ? root.item.cap : "Cap";
                    active: root.item.cap != "";
                    tip: "Hard limit on the RAM each process of this app may keep.";
                    clicked => {
                        App.command("cap", root.item.name);
                    }
                }
                if !root.compact: ActionBtn {
                    text: root.item.shielded ? "Shielded" : "Shield";
                    min-width: 62px;
                    active: root.item.shielded;
                    accent: Theme.green;
                    tip: "Shielded apps are never trimmed by any sweep.";
                    clicked => {
                        App.command("shield", root.item.name);
                    }
                }
            }
        }
    }
}

component TopAppsCard inherits Card {
    in property <bool> compact;
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            Heading {
                text: "TOP APPS";
                horizontal-stretch: 1;
            }
            Btn {
                text: "All →";
                font-size: 11px;
                pad-y: 3px;
                clicked => {
                    App.view = 1;
                    App.refresh();
                }
            }
        }
        for entry in App.top-apps: ProcessRow {
            item: entry;
            compact: root.compact;
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }
}

component ActivityCard inherits Card {
    VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            Heading {
                text: "ACTIVITY";
                horizontal-stretch: 1;
            }
            Text {
                text: App.event-count;
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
            }
        }
        if App.events.length == 0: Text {
            text: "No sweeps yet.";
            color: Theme.faint;
            font-size: 11.5px;
        }
        for event in App.events: Inset {
            border-radius: 9px;
            Rectangle {
                x: 0;
                width: 3px;
                height: parent.height - 12px;
                y: 6px;
                border-radius: 1.5px;
                background: Theme.green.with-alpha(0.7);
            }
            VerticalLayout {
                padding-left: 13px;
                padding-right: 11px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: event.title;
                        color: Theme.mint;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: event.time;
                        color: Theme.faint;
                        font-size: 10.5px;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: event.reason;
                    color: Theme.text;
                    font-size: 11.5px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: event.detail;
                    color: Theme.muted;
                    font-size: 10.5px;
                    wrap: word-wrap;
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
        }
    }
}

component OverviewView inherits Scroll {
    in property <bool> wide;
    body-height: content.preferred-height;
    content := VerticalLayout {
        padding-right: 10px;
        padding-bottom: 8px;
        spacing: 12px;
        alignment: start;
        HorizontalLayout {
            spacing: 12px;
            ReactorCard {
                width: 375px;
            }
            VerticalLayout {
                spacing: 12px;
                TelemetryCard { }
                AutoPilotCard {
                    vertical-stretch: 1;
                }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            TopAppsCard {
                compact: !root.wide;
                horizontal-stretch: 1.28;
            }
            ActivityCard {
                horizontal-stretch: 1;
                min-width: 260px;
            }
        }
    }
}

component LeakPanel inherits Rectangle {
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.red.with-alpha(0.43);
    background: Theme.red.with-alpha(0.09);
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Text {
                text: "POSSIBLE LEAKS";
                color: Theme.red;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.muted;
                Text {
                    text: "?";
                    color: Theme.muted;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Hint {
                    tip: "These apps' private memory kept growing for minutes. Trimming can't give leaked memory back — restarting the app does.";
                }
            }
        }
        for leak in App.leaks: HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 1px;
                Text {
                    text: leak.app;
                    color: Theme.text;
                    font-size: 13px;
                    font-weight: 600;
                }
                Text {
                    text: leak.meta;
                    color: Theme.muted;
                    font-size: 11.5px;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    Btn {
                        text: "Restart";
                        enabled: !leak.busy;
                        tip: "Asks the app to close (so it can save your work), then starts it again. PulseRAM never force-closes it.";
                        clicked => {
                            App.command("leak-restart", leak.app);
                        }
                    }
                    Btn {
                        text: "Dismiss";
                        tip: "Remove from this list. It comes back if the app starts growing again.";
                        clicked => {
                            App.command("leak-dismiss", leak.app);
                        }
                    }
                    Btn {
                        text: "Ignore";
                        tip: "Never list this app again (it is still trimmed by the leak guard if that's on).";
                        clicked => {
                            App.command("leak-ignore", leak.app);
                        }
                    }
                }
            }
        }
    }
}

component ProcessesView inherits Rectangle {
    VerticalLayout {
        spacing: 10px;
        Card {
            pad: 12px;
            vertical-stretch: 0;
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Field {
                        placeholder: "Search";
                        text <=> App.search;
                        horizontal-stretch: 1;
                        min-width: 120px;
                        edited(text) => {
                            App.refresh();
                        }
                    }
                    Segmented {
                        options: ["Memory", "Score", "CPU", "Growth"];
                        index <=> App.sort;
                        tip: "Sort by";
                        picked(index) => {
                            App.refresh();
                        }
                    }
                    Segmented {
                        options: ["Apps", "Processes"];
                        index <=> App.grouping;
                        tip: "Group processes of the same app, or list each one.";
                        picked(index) => {
                            App.refresh();
                        }
                    }
                    Btn {
                        text: "Thaw All";
                        accent: Theme.ice;
                        kind: 1;
                        tip: "Resume every frozen app.";
                        clicked => {
                            App.command("thaw-all", "");
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    Segmented {
                        options: ["All", "Idle & leaks", "Frozen & eco", "Shielded & capped"];
                        index <=> App.filter;
                        picked(index) => {
                            App.refresh();
                        }
                    }
                }
            }
        }
        if App.leaks.length > 0: LeakPanel {
            vertical-stretch: 0;
        }
        Scroll {
            vertical-stretch: 1;
            body-height: list.preferred-height;
            list := VerticalLayout {
                padding-right: 10px;
                padding-bottom: 8px;
                spacing: 6px;
                alignment: start;
                for entry in App.processes: ProcessRow {
                    item: entry;
                }
                if App.processes.length == 0: Text {
                    text: "Nothing matches.";
                    color: Theme.faint;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

component ProfileCard inherits Rectangle {
    in property <ProfileRow> profile;
    border-radius: 12px;
    border-width: 1px;
    border-color: profile.active ? Theme.green : Theme.line;
    background: profile.active ? Theme.green.with-alpha(0.11) : Theme.inset;
    Hint {
        tip: root.profile.description;
    }
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: root.profile.name;
            color: Theme.text;
            font-size: 14px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.profile.summary;
            color: Theme.blue;
            font-size: 11px;
            font-weight: 600;
            overflow: elide;
        }
        HorizontalLayout {
            alignment: start;
            Btn {
                text: root.profile.active ? "✓ Active" : "Activate";
                kind: root.profile.active ? 1 : 0;
                accent: Theme.green;
                font-size: 11.5px;
                clicked => {
                    App.command("profile", root.profile.id);
                }
            }
        }
    }
}

component HotkeyBox inherits Inset {
    in property <string> title;
    in property <string> keys;
    in property <color> tint;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 12.5px;
            font-weight: 700;
        }
        Text {
            text: root.keys;
            color: root.tint;
            font-size: 16px;
            font-weight: 800;
            overflow: elide;
        }
    }
}

component ProfilesView inherits Scroll {
    body-height: content.preferred-height;
    content := VerticalLayout {
        padding-right: 10px;
        padding-bottom: 8px;
        spacing: 12px;
        alignment: start;
        Card {
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Heading {
                        text: "PROFILES";
                        font-size: 13px;
                        horizontal-stretch: 1;
                    }
                    Toggle {
                        on <=> App.profiles-auto;
                        label: App.profiles-auto ? "Auto-detect" : "Manual";
                        tip: "Switch to a profile automatically when one of its apps is running.";
                        toggled(value) => {
                            App.set-flag("profiles-auto", value);
                        }
                    }
                    Btn {
                        text: "Use auto-detect";
                        tip: "Stop forcing a profile.";
                        clicked => {
                            App.command("use-auto-detect", "");
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    for profile[index] in App.profiles: ProfileCard {
                        profile: profile;
                        horizontal-stretch: 1;
                    }
                }
            }
        }
        Card {
            VerticalLayout {
                spacing: 10px;
                Heading {
                    text: "HOTKEYS";
                    font-size: 13px;
                }
                HorizontalLayout {
                    spacing: 12px;
                    Inset {
                        VerticalLayout {
                            padding: 12px;
                            spacing: 6px;
                            Text {
                                text: "Hotkeys";
                                color: Theme.text;
                                font-size: 12.5px;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                alignment: start;
                                Toggle {
                                    on <=> App.hotkeys-on;
                                    label: App.hotkeys-on ? "On" : "Off";
                                    tip: App.hotkeys-tip;
                                    toggled(value) => {
                                        App.set-flag("hotkeys", value);
                                    }
                                }
                            }
                        }
                    }
                    HotkeyBox {
                        title: "Smart";
                        keys: App.hotkey-smart;
                        tint: Theme.blue;
                    }
                    HotkeyBox {
                        title: "Deep";
                        keys: App.hotkey-deep;
                        tint: Theme.purple;
                    }
                }
            }
        }
        Card {
            VerticalLayout {
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 3px;
                        Heading {
                            text: "DEVICE";
                            font-size: 13px;
                        }
                        Text {
                            text: App.device-label;
                            color: Theme.muted;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 8px;
                            Btn {
                                text: "Re-tune";
                                tip: "Reset the trigger, free-memory floor, cooldown and profile triggers to the recommended values for this PC.";
                                clicked => {
                                    App.command("retune", "");
                                }
                            }
                            Btn {
                                text: "Logs";
                                tip: "Open the log folder (useful when reporting a problem).";
                                clicked => {
                                    App.command("logs", "");
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    Check {
                        text: "Tray %";
                        tip: "Show the live RAM % in the tray icon (green → amber → red with memory pressure).";
                        checked <=> App.tray-percent;
                        toggled(value) => {
                            App.set-flag("tray-percent", value);
                        }
                    }
                    Check {
                        text: "Eco in tray";
                        tip: "Run PulseRAM itself in Windows Efficiency Mode while it is hidden in the tray.";
                        checked <=> App.eco-in-tray;
                        toggled(value) => {
                            App.set-flag("eco-in-tray", value);
                        }
                    }
                    Check {
                        text: "Smart purge";
                        tip: "Automatic sweeps only empty the standby cache when free memory is low or Windows is already evicting cache. Manual sweeps always purge.";
                        checked <=> App.smart-purge;
                        toggled(value) => {
                            App.set-flag("smart-purge", value);
                        }
                    }
                    Check {
                        text: "Minimize to tray";
                        tip: "The minimize button hides PulseRAM to the system tray (it keeps running). Untick to minimize to the taskbar instead.";
                        checked <=> App.minimize-to-tray;
                        toggled(value) => {
                            App.set-flag("minimize-to-tray", value);
                        }
                    }
                    Check {
                        text: "Memory warnings";
                        tip: "Warn when committed memory nears the limit (RAM + page file) — what actually makes apps crash with \"out of memory\".";
                        checked <=> App.memory-warnings;
                        toggled(value) => {
                            App.set-flag("memory-warnings", value);
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Check {
                        text: "Updates";
                        tip: "Check GitHub for a new version once a day. It's the only network request PulseRAM makes, and it never downloads anything by itself.";
                        checked <=> App.updates;
                        toggled(value) => {
                            App.set-flag("updates", value);
                        }
                    }
                    Btn {
                        text: "Check now";
                        pad-y: 3px;
                        font-size: 11.5px;
                        clicked => {
                            App.command("check-updates", "");
                        }
                    }
                    Rectangle {
                        width: 8px;
                    }
                    Label {
                        text: "UI";
                        color: Theme.muted;
                    }
                    Segmented {
                        options: ["Auto", "Lite", "Full"];
                        index <=> App.ui-mode;
                        tip: "Lite: slower refresh and fewer rows — easier on low-end PCs. Auto picks Lite on low-end hardware.";
                        picked(index) => {
                            App.set-choice("ui-mode", index);
                        }
                    }
                    Label {
                        text: "Theme";
                        color: Theme.muted;
                    }
                    Segmented {
                        options: ["System", "Dark", "Light"];
                        index <=> App.theme-choice;
                        picked(index) => {
                            App.set-choice("theme", index);
                        }
                    }
                }
                Text {
                    text: "Interface made with Slint · slint.dev";
                    color: Theme.faint;
                    font-size: 10.5px;
                }
            }
        }
    }
}

component Toast inherits Rectangle {
    property <length> box-width: min(560px, root.width - 48px);
    if App.toast: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - self.height - 18px;
        width: root.box-width;
        height: toast-layout.preferred-height;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.blue.with-alpha(0.5);
        background: Theme.dark ? #101a30 : #ffffff;
        drop-shadow-blur: 18px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000066;
        toast-layout := HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 11px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 30px;
                    border-radius: 15px;
                    background: Theme.blue.with-alpha(0.18);
                    Bolt {
                        tint: Theme.blue;
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: App.toast-title;
                    color: Theme.text;
                    font-size: 12.5px;
                    font-weight: 700;
                    wrap: word-wrap;
                }
                if App.toast-sub != "": Text {
                    text: App.toast-sub;
                    color: Theme.muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// Dims the window and blocks clicks behind a dialog.
component Modal inherits Rectangle {
    in property <length> dialog-width: 460px;
    background: #000000a0;
    TouchArea { }
    Rectangle {
        width: min(root.dialog-width, root.width - 40px);
        height: body.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(12px, (root.height - self.height) / 2);
        border-radius: 14px;
        border-width: 1px;
        border-color: Theme.line;
        background: Theme.card;
        drop-shadow-blur: 30px;
        drop-shadow-color: #00000080;
        body := VerticalLayout {
            padding: 22px;
            spacing: 12px;
            @children
        }
    }
}

component CapDialog inherits Modal {
    dialog-width: 440px;
    Text {
        text: "Memory Cap — " + App.cap-app;
        color: Theme.text;
        font-size: 17px;
        font-weight: 700;
        overflow: elide;
    }
    Text {
        text: App.cap-intro;
        color: Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        for preset in [256, 512, 1024, 2048, 4096]: Btn {
            text: preset >= 1024 ? (preset / 1024) + " GB" : preset + " MB";
            font-size: 11px;
            pad-x: 9px;
            pad-y: 4px;
            clicked => {
                App.cap-value = preset;
            }
        }
    }
    Text {
        text: "Limit per process (MB)";
        color: Theme.text;
        font-size: 12px;
    }
    Field {
        text <=> App.cap-value;
        input-type: InputType.number;
        accepted => {
            App.command("cap-apply", App.cap-value);
        }
    }
    HorizontalLayout {
        spacing: 8px;
        padding-top: 6px;
        Btn {
            text: "Apply Cap";
            kind: 2;
            horizontal-stretch: 1;
            clicked => {
                App.command("cap-apply", App.cap-value);
            }
        }
        Btn {
            text: "Remove Cap";
            horizontal-stretch: 1;
            clicked => {
                App.command("cap-remove", "");
            }
        }
        Btn {
            text: "Cancel";
            horizontal-stretch: 1;
            clicked => {
                App.cap-open = false;
            }
        }
    }
}

component Paragraph inherits Text {
    color: Theme.text;
    font-size: 13.5px;
    wrap: word-wrap;
}

component WelcomeDialog inherits Modal {
    dialog-width: 500px;
    Text {
        text: "Welcome to PulseRAM";
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
    }
    Paragraph {
        text: App.welcome-device;
        font-weight: 600;
    }
    Paragraph {
        text: App.welcome-auto;
    }
    Paragraph {
        text: "Clean now any time with the big Clean button, or Ctrl + Alt + Shift + M from anywhere.";
    }
    if !App.is-admin: Paragraph {
        text: "For the deeper cleans (standby cache, page combining), click Admin at the top.";
    }
    Paragraph {
        text: "Want it out of the way? The compact button next to Auto turns PulseRAM into a small always-on-top widget.";
    }
    Check {
        text: "Start PulseRAM with Windows (in the tray)";
        checked <=> App.welcome-startup;
    }
    Check {
        text: "Tell me when a new version is out (checks GitHub once a day)";
        checked <=> App.welcome-updates;
    }
    HorizontalLayout {
        spacing: 8px;
        padding-top: 6px;
        Btn {
            text: "Get started";
            kind: 2;
            horizontal-stretch: 1;
            font-size: 13px;
            pad-y: 8px;
            clicked => {
                App.command("welcome-start", "");
            }
        }
        Btn {
            text: "Try compact view";
            horizontal-stretch: 1;
            font-size: 13px;
            pad-y: 8px;
            clicked => {
                App.command("welcome-compact", "");
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "PulseRAM";
    background: Theme.bg;
    default-font-family: "Segoe UI";
    min-width: 900px;
    min-height: 600px;
    preferred-width: 1180px;
    preferred-height: 860px;

    VerticalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 14px;
        spacing: 12px;
        TopBar {
            vertical-stretch: 0;
        }
        if App.commit-banner: Banner {
            vertical-stretch: 0;
            tint: App.commit-critical ? Theme.red : Theme.amber;
            title: App.commit-title;
            body: App.commit-body;
            if App.commit-fix: Btn {
                text: "Page-file settings";
                tip: "Opens Performance Options → Advanced → Virtual memory.";
                clicked => {
                    App.command("commit-fix", "");
                }
            }
            Btn {
                text: "Dismiss";
                clicked => {
                    App.command("commit-dismiss", "");
                }
            }
        }
        if App.update-banner: Banner {
            vertical-stretch: 0;
            tint: Theme.blue;
            title: App.update-title;
            Btn {
                text: "Download";
                kind: 2;
                tip: "Opens the release page on GitHub. Download the installer there and run it — your settings are kept.";
                clicked => {
                    App.command("update-download", "");
                }
            }
            Btn {
                text: "Skip this version";
                clicked => {
                    App.command("update-skip", "");
                }
            }
            Btn {
                text: "Later";
                tip: "Remind me later";
                clicked => {
                    App.command("update-later", "");
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            if App.view == 0: OverviewView {
                wide: root.width >= 1240px;
            }
            if App.view == 1: ProcessesView { }
            if App.view == 2: ProfilesView { }
        }
    }

    Toast {
        width: 100%;
        height: 100%;
    }

    if App.cap-open: CapDialog {
        width: 100%;
        height: 100%;
    }
    if App.welcome-open: WelcomeDialog {
        width: 100%;
        height: 100%;
    }

    TipLayer {
        width: 100%;
        height: 100%;
        window-width: root.width;
        window-height: root.height;
    }
}

component MiniIcon inherits Rectangle {
    in property <string> tip;
    in property <string> shape;
    callback clicked();
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: touch.has-hover ? Theme.chip : transparent;
    Path {
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        stroke: Theme.muted;
        stroke-width: 1.3px;
        commands: root.shape;
    }
    touch := Hint {
        tip: root.tip;
        mouse-cursor: pointer;
        clicked => {
            Tips.drop();
            root.clicked();
        }
    }
}

// The compact widget: RAM ring, used/total, one status line and one Clean button.
// Drag it anywhere by its body; it stays on top.
export component MiniWindow inherits Window {
    in property <string> percent-text: "–";
    in property <float> ratio;
    in property <int> pressure;
    in property <string> used-text: "– / – GB";
    in property <string> status;
    in property <color> status-color: Theme.muted;
    in property <string> status-tip;
    in property <string> clean-label: "Clean";
    in property <bool> cleaning;
    callback clean();
    callback expand();
    callback hide-to-tray();
    callback context-menu();
    callback dragged(length, length);
    callback hover(bool);

    title: "PulseRAM";
    no-frame: true;
    always-on-top: true;
    background: Theme.card;
    default-font-family: "Segoe UI";
    width: 304px;
    height: 104px;

    Rectangle {
        border-width: 1px;
        border-color: Theme.line;
    }

    body := TouchArea {
        moved => {
            if (self.pressed) {
                root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        double-clicked => {
            root.expand();
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context-menu();
            }
        }
        changed has-hover => {
            root.hover(self.has-hover || clean-touch.has-hover);
        }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            ring := Rectangle {
                width: 72px;
                height: 72px;
                property <float> shown: root.ratio;
                animate shown {
                    duration: 350ms;
                    easing: ease-out;
                }
                Rectangle {
                    x: 3px;
                    y: 3px;
                    width: 66px;
                    height: 66px;
                    border-radius: 33px;
                    border-width: 6px;
                    border-color: Theme.track;
                }
                Path {
                    width: 72px;
                    height: 72px;
                    viewbox-width: 72;
                    viewbox-height: 72;
                    stroke: Theme.pressure(root.pressure);
                    stroke-width: 6px;
                    stroke-line-cap: round;
                    MoveTo {
                        x: 36;
                        y: 6;
                    }
                    ArcTo {
                        x: 36 + 30 * sin(clamp(ring.shown, 0.005, 0.999) * 360deg);
                        y: 36 - 30 * cos(clamp(ring.shown, 0.005, 0.999) * 360deg);
                        radius-x: 30;
                        radius-y: 30;
                        sweep: true;
                        large-arc: ring.shown > 0.5;
                    }
                }
                Text {
                    text: root.percent-text;
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.used-text;
                color: Theme.text;
                font-size: 14px;
                font-weight: 600;
            }
            Text {
                text: root.status;
                color: root.status-color;
                font-size: 11.5px;
                overflow: elide;
            }
            HorizontalLayout {
                alignment: start;
                padding-top: 6px;
                Rectangle {
                    height: 28px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.blue.with-alpha(0.55);
                    background: Theme.blue.with-alpha(clean-touch.has-hover ? 0.3 : 0.2);
                    opacity: root.cleaning ? 0.6 : 1;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        VerticalLayout {
                            alignment: center;
                            Bolt {
                                tint: Theme.text;
                                width: 9px;
                                height: 13px;
                            }
                        }
                        Text {
                            text: root.cleaning ? "Cleaning…" : root.clean-label;
                            color: Theme.text;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    clean-touch := TouchArea {
                        enabled: !root.cleaning;
                        mouse-cursor: pointer;
                        clicked => {
                            root.clean();
                        }
                        changed has-hover => {
                            root.hover(self.has-hover || body.has-hover);
                        }
                    }
                }
            }
        }
        VerticalLayout {
            alignment: start;
            spacing: 4px;
            MiniIcon {
                tip: "Full view";
                shape: "M 1 1 H 11 V 11 H 1 Z M 1 4 H 11";
                clicked => {
                    root.expand();
                }
            }
            MiniIcon {
                tip: "Hide to tray";
                shape: "M 2 9 H 10";
                clicked => {
                    root.hide-to-tray();
                }
            }
        }
    }
}
